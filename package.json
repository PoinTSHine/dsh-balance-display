{
  "name": "dsh-balance-display",
  "version": "1.5.0",
  "private": true,
  "description": "DSH web plugin: an account-balance box in the left sidebar in the Settings button's own style, plus a session-cost pill in the composer dock beside the token-usage reading. The provider query runs in the local server half, so the API key never reaches the browser.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin",
    "balance",
    "credits",
    "sidebar"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "test"
  ],
  "scripts": {
    "test": "node test/verify.mjs && node test/client.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
